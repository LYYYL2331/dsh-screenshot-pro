{
  "name": "dsh-screenshot-pro",
  "version": "2.0.0",
  "description": "A visible screenshot button for DeepSeek Harness: click, drag, confirm. Fork of @paicat1/dsh-screenshot.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LYYYL2331/dsh-screenshot-pro"
  },
  "author": "LYYYL2331",
  "type": "module",
  "license": "MIT",
  "main": "dsh/index.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "capture"
  ],
  "files": [
    "dsh",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./package.json": "./package.json",
    "./client": "./dsh/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
